# =============================================================================
# HELLO environment configuration. Copy to .env.local for local development.
# Never commit real values. Never put secrets in NEXT_PUBLIC_* variables:
# those are shipped to the browser.
# =============================================================================

# --- Storage ----------------------------------------------------------------
# A directory for durable storage (accounts, posts, media, games...). Use a persistent
# disk and run ONE instance. Unset: everything is kept in memory and lost on restart.
HELLO_DATA_DIR=

# --- Calls ------------------------------------------------------------------
# JSON list of STUN/TURN servers for video calls, e.g.
#   [{"urls":"stun:stun.example.org:3478"},{"urls":"turn:turn.example.org:3478","username":"u","credential":"p"}]
# Unset: calls connect only between people on the same network, and no third party is contacted.
# TURN credentials are handed to call participants (browsers need them): use short-lived ones.
HELLO_ICE_SERVERS=

# --- Demo mode -------------------------------------------------------------
# true  : demo sign-in (seeded demo accounts) is enabled.
# false : demo sign-in is disabled.
# unset : enabled in development, disabled in production.
# Demo sign-in is NOT authentication: anyone can become any seeded account, and an
# organiser can reset all data. Set to false for a real event. Real accounts
# (handle and password) work either way.
HELLO_DEMO_MODE=true

# --- Nexconn (Chat SDK, Chat UI, Call SDK) -------------------------------
# App Key: identifies the app; the browser receives it with a server-issued token.
# App Secret: signs server API calls. SERVER ONLY: never prefix it with NEXT_PUBLIC_,
# never send it to a browser, never commit it. Both come from the Nexconn Console.
# With both set, POST /api/nexconn/token issues a user token for the signed-in person
# (signed Platform Chat API call, src/integrations/nexconn/token.ts).
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# The app's data centre as shown in the console: BJ, SG, NA, SG_B, SA or OM. Default SG.
NEXCONN_AREA=SG

# --- Supabase (database and auth) -----------------------------------------
# Not read by this build yet: the app runs on the in-memory demo store.
# Listed here so the production wiring has a fixed set of names.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider ----------------------------------------------------------
# Not read by this build. With no provider the deterministic interpreter is used
# and the UI says so. A provider adapter must implement IntentProvider (src/ai/intent.ts).
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_INTENT_TIMEOUT_MS=4000

# --- Web research (agent mesh) ---------------------------------------------
# Optional. Lets the web research agent answer questions about the world outside
# the venue ("nearest pharmacy") that the event guide does not cover. Queries are
# redacted (names, emails, phone numbers removed) and cached for 10 minutes.
# Supported provider: tavily. Leave empty to disable; replies then say so.
HELLO_WEB_SEARCH_PROVIDER=
HELLO_WEB_SEARCH_API_KEY=

# --- Data at rest -----------------------------------------------------------
# 32 random bytes, base64. Seals profile text with AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, a per-process key is generated and sealed data is lost on restart.
# Private messages do not use this key: they are end-to-end encrypted in the browser.
HELLO_DATA_KEY=

# --- Database (Postgres) -----------------------------------------------------
# Set to use Postgres instead of the in-memory store: durable, and safe for several app instances. The
# schema is created on first start. Live updates then reach every instance (LISTEN/NOTIFY).
DATABASE_URL=
# Optional schema name (default public).
HELLO_DB_SCHEMA=

# --- Chat gateway (Nexconn or any chat network) ----------------------------
# Both set: notifications are delivered to linked chat accounts through your bridge, and the bridge can post
# messages to /api/integrations/chat/inbound. Requests are signed with HMAC-SHA256 both ways.
# See docs/nexconn-integration.md. The secret must be 32+ characters; the URL must be https (or localhost).
HELLO_CHAT_SECRET=
HELLO_CHAT_OUTBOUND_URL=

# --- Privacy filter (integrated from Offleak) --------------------------------
# Public origin used for the Twitch OAuth redirect (<origin>/twitch/callback) when HELLO runs behind a proxy that
# rewrites the request origin. Unset: the request origin is used. Models: run `npm run privacy:assets` once.
HELLO_PUBLIC_URL=
