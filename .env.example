# =============================================================================
# HELLO environment configuration. Copy to .env.local for local development.
# Never commit real values. Never put secrets in NEXT_PUBLIC_* variables:
# those are shipped to the browser.
# =============================================================================

# --- Demo mode -------------------------------------------------------------
# true  : demo sign-in (seeded demo accounts) is enabled.
# false : demo sign-in is disabled.
# unset : enabled in development, disabled in production.
# Demo sign-in is NOT authentication. Do not enable it for a real event.
HELLO_DEMO_MODE=true

# --- Nexconn (messaging transport) ----------------------------------------
# Required to report a configured Nexconn connection. This build does not
# open an SDK connection, so the app still reports that messages are not
# delivered through Nexconn. Obtain the app key from the Nexconn developer console.
NEXCONN_APP_KEY=

# --- Supabase (database and auth) -----------------------------------------
# Not read by this build yet: the app runs on the in-memory demo store.
# Listed here so the production wiring has a fixed set of names.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider ----------------------------------------------------------
# Not read by this build. With no provider the deterministic interpreter is used
# and the UI says so. A provider adapter must implement IntentProvider (src/ai/intent.ts).
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_INTENT_TIMEOUT_MS=4000
