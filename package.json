{
  "name": "hello-event-coordination",
  "version": "0.1.0",
  "private": true,
  "description": "HELLO \u2014 One conversation. Everyone connected. AI-assisted event coordination.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:e2e": "node tests/e2e/judge-flow.mjs && node tests/e2e/features-flow.mjs && node tests/e2e/workflow-audit.mjs && node tests/e2e/private-messages.mjs",
    "test:routes": "node tests/e2e/route-crawl.mjs",
    "screenshots": "node tests/e2e/screenshots.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "playwright": "^1.63.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
