        "./src/chatdom/packages/content/src/forge-slots/index.ts"
      ],
      "@chatdom/content/anvil-hero": [
        "./src/chatdom/packages/content/src/anvil-hero/index.ts"
      ],
      "@chatdom/content/genesis-landmarks": [
        "./src/chatdom/packages/content/src/genesis-landmarks/index.ts"
      ],
      "@chatdom/content/growth-civic": [
