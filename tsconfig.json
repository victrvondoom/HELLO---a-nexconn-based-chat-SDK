      ],
      "@chatdom/content/avatars": [
        "./src/chatdom/packages/content/src/avatars/index.ts"
      ],
      "@chatdom/content/forge-motifs": [
        "./src/chatdom/packages/content/src/forge-motifs/index.ts"
      ],
      "@chatdom/content/forge-ornaments": [
        "./src/chatdom/packages/content/src/forge-ornaments/index.ts"
